# =============================================================================
# WorkFlex Bridge Agent — Environment Configuration
# =============================================================================
#
# SETUP STEPS
# -----------
# 1. Copy this file:  cp .env.example .env
#
# 2. Fill in your real Anthropic API key below.
#
# 3. Start the services:
#      docker compose up -d mock-api
#      docker compose up -d bridge-agent
#
# Jira, HubSpot, and Teams tokens are fetched automatically from the mock
# server at runtime — no dashboard steps or manual token copying required.
# =============================================================================


# ── Anthropic ─────────────────────────────────────────────────────────────────
# Your real Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use for the agent loop
CLAUDE_MODEL=claude-sonnet-4-6


# ── Mock server ───────────────────────────────────────────────────────────────
# Use http://localhost:8080 when running locally.
# docker-compose.yml overrides this to http://mock-api:8080 inside Docker —
# you do not need to change this value when using docker compose.
MOCK_BASE_URL=http://localhost:8080


# ── Jira credentials ──────────────────────────────────────────────────────────
# Email used as the Basic auth username (default matches mock server seed).
# The API token is fetched automatically from the mock server at runtime.
JIRA_EMAIL=candidate@workflex.com


# ── HubSpot / Teams ───────────────────────────────────────────────────────────
# Tokens and secrets are fetched automatically from the mock server at runtime.
# Client ID is the only value needed for the Teams OAuth2 flow.
TEAMS_CLIENT_ID=bridge-agent


# ── Agent tuning ──────────────────────────────────────────────────────────────
# Maximum number of Teams messages to fetch per process run (mock hard cap: 50)
TEAMS_MESSAGE_LIMIT=50

# Abort the agentic loop if Claude exceeds this many turns (hallucination guard)
AGENT_MAX_ITERATIONS=50

# Seconds before a single Anthropic API call times out
AGENT_TIMEOUT_SECONDS=120.0


# ── API authentication ────────────────────────────────────────────────────────
# All /api/* endpoints require this value in the X-API-Key request header.
# Leave empty to disable auth (local dev only — never empty in production).
API_KEY=
